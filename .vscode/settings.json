{
  // LaTeX Workshop: compila informe/main.tex al guardar, con el mismo
  // latexmk + informe/.latexmkrc que usa `make` (LaTeX Workshop corre en
  // informe/, así que latexmk lee ese .latexmkrc solo), y deja el PDF en build/informe.
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.search.rootFiles.include": ["informe/main.tex"],
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/informe",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "latexmk (informe)",
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (informe)", "tools": ["latexmk-informe"] }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-informe",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.view.pdf.viewer": "tab",
  "files.exclude": {
    "build/**/*.aux": true,
    "build/**/*.fls": true,
    "build/**/*.fdb_latexmk": true
  },

  // Python: motor HMM (src/apthmm) con el entorno .venv del repo.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-p", "no:warnings"],
  "files.watcherExclude": {
    "**/data/**": true,
    "**/results/**": true,
    "**/.venv/**": true
  }
}

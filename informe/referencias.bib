	date = {2023},
	file = {Versión enviada:C\:\\Users\\franc\\Zotero\\storage\\UARX8H6L\\Chen et al. - 2023 - Machine Learning-Enabled IoT Security Open Issues and Challenges Under Advanced Persistent Threats.pdf:application/pdf},
}


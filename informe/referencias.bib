@article{kim_intrusion_2021,
	title = {Intrusion Detection Based on Sequential Information Preserving Log Embedding Methods and Anomaly Detection Algorithms},
	volume = {9},
	url = {https://www.scopus.com/pages/publications/85104184841?origin=resultslist},
	doi = {10.1109/ACCESS.2021.3071763},
	abstract = {Previous methods for system intrusion detection have mainly consisted of those based on pattern matching that employs prior knowledge extracted from experts' domain knowledge. However, pattern matching-based methods have a major drawback that it can be bypassed through various modified techniques. These advanced persistent threats cause limitation to the pattern matching-based detecting mechanism, because they are not only more sophisticated than usual threats but also specialized in the targeted attacking object. The defense mechanism should have to comprehend unusual phenomenons or behaviors to successfully handles the advanced threats. To achieve this, various security techniques based on machine learning have been developed recently. Among these, anomaly detection algorithms, which are trained in unsupervised fashion, are capable of reducing efforts of security experts and securing labeled dataset through post analysis. It is further possible to distinguish abnormal behaviors more precisely by training classification models if sufficient amounts of labeled dataset is obtained through post analysis of anomaly detection results. In this study, we proposed an end-to-end abnormal behavior detection method based on sequential information preserving log embedding algorithms and machine learning-based anomaly detection algorithms. Contrary to other machine learning based system anomaly detection models, which borrow domain experts' knowledge to extract significant features from the log data, raw log data are transformed into a fixed size of continuous vector regardless of their length, and these vectors are used to train the anomaly detection models. Experimental results based on a real system call trace dataset, our proposed log embedding method with unsupervised anomaly detection model yielded a favorable performance, at most 0.8708 in terms of {AUROC}, and it can be further improved up to 0.9745 with supervised classification algorithms if sufficient labeled attack log data become available. © 2013 {IEEE}.},
	pages = {58088--58101},
	journaltitle = {{IEEE} Access},
	author = {Kim, C. and Jang, M. and Seo, S. and Park, K. and Kang, P.},
	date = {2021},
	keywords = {Anomaly detection, Intrusion detection, advanced persistent threat, Signal detection, Data mining, Pattern matching, Learning systems, Embeddings, Supervised learning, Classification (of information), Classification models, cyber security, Embedding algorithms, Abnormal behavior detections, {ADFA}-{LD}, Anomaly detection models, Anomaly-detection algorithms, Knowledge acquisition, Sequential information, Supervised classification, System anomaly detection, system log embedding, Unsupervised anomaly detection},
	file = {Full Text PDF:C\:\\Users\\franc\\Zotero\\storage\\JA6ISSGK\\Kim et al. - 2021 - Intrusion Detection Based on Sequential Information Preserving Log Embedding Methods and Anomaly Det.pdf:application/pdf},
}

@article{lahari_intelligent_2026,
	title = {Intelligent Deep Learning with Swarm-Based Optimization for Resilient 6G-{IoT} Communication Systems},
	volume = {19},
	url = {https://www.scopus.com/pages/publications/105042401418?origin=resultslist},
	doi = {10.25103/jestr.192.19},
	abstract = {The implementation of 6G-enabled Internet of Things (6G-{IoT}) offers ultra-dense connections, heterogeneous traffic, and a widened cyber-attack area, necessitating fundamentally dynamic and comparatively economic intrusion detection solutions. The traditional approach to Machine Learning ({ML}) and individual Deep Neural Networks ({DNN}) incline to poorly tune hyper-parameters and fail to converge in the situation of multi-stage attacks. In order to address these limitations, this paper suggests an intelligent intrusion detection Firefly Algorithm ({FA})-optimized {DNN} ({FA}-{DNN}) framework that can be implemented in next-generation {IoT} ecosystems. The presented model is tested on the {MSCAD} (Multi-Step Cyber-Attack Dataset), which contains 128,799 cases with 66 traffic features and various categories of coordinated attacks, such as brute-force, port scanning, {HTTP}-{DDoS}, {ICMP} flooding, and web crawling. It uses a rigorous pre-processing pipeline, which includes normalization, {SMOTE}-based class balancing and data partitioning based on leakage-free. Cross-validation on a 10-fold basis has shown that {FA}-{DNN} can make a classification accuracy of 99.95 with better F1-score and smaller variations across folds. The proposed method has faster convergence (47 epochs) and optimisation stability when compared with {GA}-{DNN} and {PSO}-{DNN}. Even though the swarm-based optimization introduces complexity to the training process, the practical feasibility is proven by the analysis using the {GPUs}, having controlled training time (1180 s) and average peak memory consumption (8.6 {GB}). Remarkably, the inference-time complexity is no higher than that of a conventional {DNN} optimized. The findings suggest {FA}-{DNN} as a high-precision, scalable, and deployable security solution for future 6G-{IoT} infrastructures. © 2026 School of Science, {DUTH}. All rights reserved.},
	pages = {168--180},
	number = {2},
	journaltitle = {Journal of Engineering Science and Technology Review},
	author = {Lahari, S. and Rao, K.E. and Dasari, S. and Kishore, C.R.},
	date = {2026},
	keywords = {Security, Intrusion detection, Network security, Denial-of-service attack, Multi-step attacks, Optimization, Intrusion-Detection, Crime, Cyber-attacks, Multisteps, Cyber attacks, Complex networks, Learning systems, Network intrusion, Particle swarm optimization ({PSO}), Internet of things, Neural-networks, Optimisations, {IDS}, 6g-enabled internet of thing security, 6G-{IoT} security, Balancing, {DL}, {DNN}, {FA}, Firefly algorithms, Hyper-parameter, {MSCAD}, Multi-step cybe-attack dataset, Pipeline processing systems, Swarm intelligence, Web crawler},
	file = {Texto completo:C\:\\Users\\franc\\Zotero\\storage\\MLCUPVEW\\Lahari et al. - 2026 - Intelligent Deep Learning with Swarm-Based Optimization for Resilient 6G-IoT Communication Systems.pdf:application/pdf},

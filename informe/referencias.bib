@article{p_firdani_multi-layer_2026,
	title = {Multi-Layer {APT} Detection Framework with {OSINT} Enrichment},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2026.3730461},
	abstract = {Advanced Persistent Threats ({APTs}) are multi-stage campaigns whose detection requires correlating signals across endpoint, network, and external intelligence sources. Existing provenance-based detectors rarely incorporate external threat intelligence, and existing Open Source Intelligence ({OSINT}) pipelines rely almost exclusively on {IP} and domain reputation, which is inapplicable to private Industrial Internet of Things ({IIoT}) networks. This paper presents an integration framework that combines established graph-based detectors with an adaptive {OSINT} strategy and a transparent hypothesis-scoring rubric. The framework is organized in four layers: (i) detection using existing graph models ({MAGIC} for provenance, a Graph Isomorphism Network with Edge Features ({GINE}) for {IIoT} traffic), (ii) ground-truth validation, (iii) adaptive {OSINT} enrichment that uses {IP}-based queries for public networks and tool-based {OSINT} for private networks, and (iv) an eight-criterion (C1–C8) hypothesis-scoring rubric that operates in a dual ground-truth / {OSINT}-only mode. The contribution of this work is the integration architecture, the tool-based {OSINT} mechanism, the formalized scoring rubric, and a per-layer ablation study—not a new detector. We evaluate on five benchmarks across three domains: {DARPA} {TC} E3 ({CADETS}, {THEIA}, {TRACE}), synthetic batch graphs ({StreamSpot}, Wget), {MAWI} backbone traces, and {CICAPT}-{IIoT}. Detection {AUC} ranges from 0.998 on enterprise provenance to 0.939 on highly imbalanced {IIoT} traffic ({AUPRC} 0.654, reflecting a 0.01\% malicious-node rate). On datasets with documented {APT} campaigns, the dual-mode rubric reaches 75–100\% inter-mode agreement, and the ablation study shows that the full four-layer configuration is the only one that attains this agreement simultaneously under both ground-truth and {OSINT}-only scoring. We report all limitations of the evaluation, including the controlled nature of the {OSINT} validation set (n=80 {IoCs}; 100\% accuracy under verified ground truth and 52.5\% under uncontrolled conditions, revealing {IoC}-type-specific threshold sensitivity), the circular nature of {APT}29 attribution on an {APT}29-emulated dataset, and the absence of quantitative comparison against retrained baselines.},
	pages = {1--1},
	journaltitle = {{IEEE} Access},
	author = {{P. Firdani} and {M. L. Han} and {Y. Kim} and {J. Kang}},
	date = {2026},
	keywords = {intrusion detection, Tools, Computer security, Advanced Persistent Threats, {IP} networks, {MITRE} {ATT}\&{CK}, Modeling, Signal detection, Grounding, Labeling, {DARPA}, Industrial Internet of Things, Detectors, {IIoT} security, graph isomorphism networks, {OSINT}, provenance graphs},
	file = {Full Text PDF:C\:\\Users\\franc\\Zotero\\storage\\7IVFE3HA\\P. Firdani et al. - 2026 - Multi-Layer APT Detection Framework with OSINT Enrichment.pdf:application/pdf},
}

@article{r_huang_efficient_2026,
	title = {Efficient Network Attack Detection Method Combining {SSPCA} and Layered Detection},
	volume = {15},
	issn = {2245-4578},
	doi = {10.13052/jcsm2245-1439.1523},
	abstract = {With the deep integration of industrial control networks and information technology, the problems of high-dimensional data redundancy, multi-stage attack concealment and class imbalance lead to the inefficiency of traditional intrusion detection methods. To this end, the new frameworks of Stacked Sparse Principal Component Analysis ({SSPCA}) and Step-by-Step Industrial Control Intrusion Detection ({SSICID}) are proposed. The {SSPCA} reduced the dimensionality of high-dimensional industrial control network traffic data to 12 dimensions by sparse constraint and principal component stacking strategy, which improved the accuracy by 62.5\% compared with traditional Principal Component Analysis ({PCA}). The {SSICID} used a layered detection architecture to achieve 98.8\% detection accuracy, 97.0\% recall, and 0.3 second {CPU} response time on {ICS}-{CERT} datasets, which was 4.5\% more accurate and 40\% faster than the existing optimal model. The proposed model provides an efficient solution for the real-time monitoring of complex attacks in industrial control networks and has important practical significance for ensuring the security of critical infrastructure.},
	pages = {335--364},
	number = {2},
	journaltitle = {Journal of Cyber Security and Mobility},
	author = {{R. Huang}},

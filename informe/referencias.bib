	author = {{M. U. Basharat} and {J. Hussain} and {C. F. Kwong} and {W. Khalid}},
	urldate = {0005-01-01},
	date = {2026},
	keywords = {Security, Anomaly detection, Machine learning, Internet of Things, Support vector machines, Anomaly Detection, Machine Learning, Accuracy, Intrusion Detection, Modeling, Random forests, {IoT} Security, Random Forest, Zero Trust Security, Poles and zeros, Zero Trust},
	file = {Preprint PDF:C\:\\Users\\franc\\Zotero\\storage\\M62W9IAF\\M. U. Basharat et al. - 2026 - Advanced Anomaly Detection and Threat Intelligence in Zero Trust IoT Environments Using Machine Lear.pdf:application/pdf},

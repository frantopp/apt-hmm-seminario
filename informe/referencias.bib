@article{salah_dual-model_2026,
	title = {A Dual-Model Deep Learning Framework With Consensus-Based Ensemble for Advanced Persistent Threat Detection in Industrial Internet of Things Networks},
	volume = {14},
	url = {https://www.scopus.com/pages/publications/105043040090?origin=resultslist},
	doi = {10.1109/ACCESS.2026.3704915},
	abstract = {The security of Industrial Internet of Things ({IIoT}) networks is increasingly threatened by Advanced Persistent Threats ({APTs}), whose rarity and stealth make reliable detection particularly challenging. A fundamental obstacle is the extreme class imbalance, where malicious flows represent only a minute fraction of observed data. This paper proposes a novel intrusion detection framework, termed {DTE}-{IDS}, which employs a dual-model deep transfer learning ensemble to achieve high attack detection sensitivity while maintaining a low false-positive rate. The framework is evaluated on the {CICAPT}-{IIoT} dataset, comprising 9.5 million benign flows and 1,004 attack instances. To address class imbalance, a two-stage strategy is applied exclusively to the training partition, combining Synthetic Minority Over-sampling with balanced class weighting during optimization. Each network flow is transformed into a two-dimensional image, enabling per-flow classification without reliance on temporal sequencing or window-based aggregation. This representation is used to fine-tune two pre-trained convolutional architectures, {InceptionV}3 and {InceptionResNetV}2. During inference, a strict two-out-of-two hard-voting mechanism flags an attack only when both models agree. The proposed framework is validated on a realistic, non-oversampled test set with over 1.9 million benign and 201 attack samples. The ensemble achieves a recall of 95.02\%, a precision of 70.48\%, an F1-score of 80.93\%, and a {PR}-{AUC} of 0.9069, while producing only 80 false positives - approximately 133 false alerts per day at the {CICAPT}-{IIoT} testbed traffic rate of 36.8 flows per second. These results highlight the framework's effectiveness in detecting rare, high-impact threats in operational {IIoT} environments.  © 2026 The Authors.},
	pages = {92980--93008},
	journaltitle = {{IEEE} Access},
	author = {Salah, A.H. and Gomaa, A. and Ogawa, T. and Kasem, H.M.},
	date = {2026},
	keywords = {Advanced persistent threat, intrusion detection, Computer crime, Intrusion detection, Network security, Convolutional neural networks, Transfer learning, Deep neural networks, Intrusion-Detection, Learning systems, Convolutional neural network, Convolution, Network intrusion, Internet of things, Advanced persistent threats ({APTs}), Industrial internet of thing, class imbalance, Class imbalance, convolutional neural networks, deep transfer learning, Deep transfer learning, Dual model, ensemble learning, Ensemble learning, industrial Internet of Things, Learning frameworks},
	file = {Full Text PDF:C\:\\Users\\franc\\Zotero\\storage\\TS7EZBWE\\Salah et al. - 2026 - A Dual-Model Deep Learning Framework With Consensus-Based Ensemble for Advanced Persistent Threat De.pdf:application/pdf},
